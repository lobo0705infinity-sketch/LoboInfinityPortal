{
  "installCommand": "npm install",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "functions": {
    "api/automation-queue-worker.mjs": {
      "maxDuration": 300
    },
    "api/public-snapshot-publish.mjs": {
      "maxDuration": 300
    },
    "api/public-search-page.mjs": {
      "includeFiles": "dist/app-shell.html"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/faction-portraits/optimized/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/maps/43-ll-map-13-data-heist-double-bind",
      "destination": "/maps/43-ll-map-13-data-harvest-double-bind",
      "permanent": true
    },
    {
      "source": "/maps/44-ll-map-14-data-heist-double-bind",
      "destination": "/maps/44-ll-map-14-data-harvest-double-bind",
      "permanent": true
    },
    {
      "source": "/hall-of-fame",
      "destination": "/analytics",
      "permanent": true
    },
    {
      "source": "/rivalries",
      "destination": "/compare",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/",
      "destination": "/api/public-search-page?page=/"
    },
    {
      "source": "/:page(explore|army-intelligence|games|maps|events|players|factions|missions|streams|army-lists|analytics|compare|standings|schedule|league-operations|community|rules)",
      "destination": "/api/public-search-page?page=/:page"
    },
    {
      "source": "/games/:id",
      "destination": "/api/public-search-page?page=/games/:id"
    },
    {
      "source": "/maps/:slug",
      "destination": "/api/public-search-page?page=/maps/:slug"
    },
    {
      "source": "/event/:id",
      "destination": "/api/public-search-page?page=/event/:id"
    },
    {
      "source": "/factions/:name",
      "destination": "/api/public-search-page?page=/factions/:name"
    },
    {
      "source": "/missions/:name",
      "destination": "/api/public-search-page?page=/missions/:name"
    },
    {
      "source": "/(.*)",
      "destination": "/app-shell.html"
    }
  ]
}
