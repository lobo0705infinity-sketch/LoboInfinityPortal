# Borderless mat: 2 x 2 units, top y=0.1, bottom y=0.
# Scale 24,1,24 gives a 48 x 48-inch textured face, 0.1-inch thick.
o LoboBorderlessMat
v -1 0.1 -1
v -1 0.1 1
v 1 0.1 1
v 1 0.1 -1
v -1 0 -1
v -1 0 1
v 1 0 1
v 1 0 -1
vt 0 0
vt 0 1
vt 1 1
vt 1 0
vn 0 1 0
vn 0 -1 0
vn -1 0 0
vn 1 0 0
vn 0 0 -1
vn 0 0 1
s off
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
f 5/1/2 8/4/2 7/3/2
f 5/1/2 7/3/2 6/2/2
f 5/1/3 6/2/3 2/2/3
f 5/1/3 2/2/3 1/1/3
f 8/4/4 4/4/4 3/3/4
f 8/4/4 3/3/4 7/3/4
f 5/1/5 1/1/5 4/4/5
f 5/1/5 4/4/5 8/4/5
f 6/2/6 7/3/6 3/3/6
f 6/2/6 3/3/6 2/2/6
