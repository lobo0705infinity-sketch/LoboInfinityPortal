function lifWorkshopMapChoices_(formType) {
  const allowed = formType === LIF_FORMS.TYPES.CASUAL
    ? LIF_WORKSHOP_MAPS.map(function(map) { return map.slug; })
    : formType === LIF_FORMS.TYPES.LEAGUE
      ? LIF_WORKSHOP_MAP_SCOPES["event-current-league"]
      : formType === LIF_FORMS.TYPES.TEAM
        ? LIF_WORKSHOP_MAP_SCOPES["event-august-2026-team-tournament"] : [];
  return LIF_WORKSHOP_MAPS.filter(function(map) { return allowed.indexOf(map.slug) >= 0; })
    .map(function(map) { return map.label; });
}

function lifWorkshopMapSlug_(formType, label) {
  const value = String(label || "").trim();
  if (!value) return "";
  const map = LIF_WORKSHOP_MAPS.filter(function(candidate) { return candidate.label === value; })[0];
  if (!map || lifWorkshopMapChoices_(formType).indexOf(value) < 0)
    throw new Error("Workshop Map is not in this submission form's collection.");
  return map.slug;
}
