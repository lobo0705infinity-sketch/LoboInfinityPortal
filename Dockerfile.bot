FROM node:24.13.0-bookworm-slim

WORKDIR /app

COPY lobo-infinity-portal/package.json lobo-infinity-portal/package-lock.json ./
RUN npm ci
RUN npx playwright install --with-deps chromium

COPY lobo-infinity-portal/ .
RUN node scripts/rules-reported-interactions-check.mjs
RUN node scripts/rules-deepseek-check.mjs
RUN npm run test:build-list
RUN node scripts/tts-2d-export-check.mjs
RUN node scripts/bot-improvements-check.mjs
RUN npm run test:random-list
RUN npm run test:inf-list-classifieds

CMD ["node", "bot/lobos-little-helper.mjs"]
